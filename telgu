Remotes.BroadcastMessage.OnClientEvent:Connect(function(payload)
    if payload.Action == "Delete" then
        local item = State.MessageById[payload.Id]
        if item then
            item:Destroy()
            State.MessageById[payload.Id] = nil
        end
        return
    end

    addMessage(payload, false)
end)

Remotes.BroadcastDM.OnClientEvent:Connect(function(payload)
    if State.DMTarget and (
        payload.SenderId == State.DMTarget.UserId
        or payload.TargetId == State.DMTarget.UserId
