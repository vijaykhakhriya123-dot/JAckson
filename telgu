--==================================================
-- HTTP REQUEST
--==================================================

local Request =
    (syn and syn.request)
    or (http and http.request)
    or http_request
    or request
    or (fluxus and fluxus.request)

if not Request then
    warn("RUBO: HTTP request function not available.")
    return
end

local function Http(method, url, body)
    local ok, result = pcall(function()
        return Request({
            Url = url,
            Method = method,
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = body
        })
    end)

    if not ok then
        return nil
    end

    return result
end

