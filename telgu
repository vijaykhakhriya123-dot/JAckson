local function clearChatRows()
    for _, child in ipairs(chatList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
end

local function addChatRow(item, order)
    local row = panel(chatList, UDim2.new(), UDim2.new(1, -12, 0, 54))
    row.LayoutOrder = order

    local name = tostring(item.displayName or item.username or "Unknown")
    local text = tostring(item.text or "")
    label(row, name, UDim2.fromOffset(8, 5), UDim2.new(1, -16, 0, 17), 10, THEME.LightBlue)
    label(row, text, UDim2.fromOffset(8, 23), UDim2.new(1, -16, 0, 24), 9, THEME.Text)
end

local lastChatSignature = ""
local function refreshChat()
    local ok, data = firebaseReadMessages()
    if not ok then
        chatStatus.Text = "Firebase: " .. tostring(data)
        return
    end

    clearChatRows()
    local items = {}

    if type(data) == "table" then
        for key, item in pairs(data) do
            if type(item) == "table" then
                item._key = tostring(key)
                table.insert(items, item)
            end
        end
    end

    table.sort(items, function(a, b)
        return tonumber(a.timestamp or 0) < tonumber(b.timestamp or 0)
    end)

    -- Keep the UI lightweight.
    local startIndex = math.max(1, #items - 30 + 1)
    local signatureParts = {}
    for i = startIndex, #items do
        table.insert(signatureParts, tostring(items[i]._key) .. ":" .. tostring(items[i].text))
    end
    local signature = table.concat(signatureParts, "|")

    if signature ~= lastChatSignature then
        for i = startIndex, #items do
            addChatRow(items[i], i)
        end
        lastChatSignature = signature
        task.defer(function()
            pcall(function()
                chatList.CanvasPosition = Vector2.new(0, math.max(0, chatList.AbsoluteCanvasSize.Y))
            end)
        end)
    end

    chatStatus.Text = "Firebase connected • " .. tostring(#items) .. " message(s)"
end

local sending = false
local function sendCurrentChat()
    if sending then return end
    local text = chatInput.Text
    if text:gsub("%s", "") == "" then return end

    sending = true
    sendChat.Text = "..."
    local ok, err = firebaseSendMessage(text)
    if ok then
        chatInput.Text = ""
        chatStatus.Text = "Message sent."
        task.spawn(refreshChat)
    else
        chatStatus.Text = tostring(err)
        notify("Chat error: " .. tostring(err))
    end
    sendChat.Text = "SEND"
    sending = false
end

sendChat.Activated:Connect(sendCurrentChat)
chatInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then sendCurrentChat() end
end)

task.spawn(function()
    while gui and gui.Parent do
        if main.Visible then
            refreshChat()
        end
        task.wait(FIREBASE_POLL_INTERVAL)
    end
end)


