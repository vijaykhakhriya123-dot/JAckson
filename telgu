local function send()
    local text = MessageInput.Text
    if text == "" then return end

    MessageInput.Text = ""
    State.TypingSent = false
    Remotes.SendTyping:FireServer(false)

    if State.DMTarget then
        local ok, msg = Remotes.SendDM:InvokeServer(State.DMTarget.UserId, text)
        if not ok then
            notify(msg or "DM failed.")
        end
    else
        local replyId = State.Reply and State.Reply.Id or nil
        local ok, msg = Remotes.SendMessage:InvokeServer(text, replyId)
        if not ok then
            notify(msg or "Message failed.")
        end
    end

    setReply(nil)
end

