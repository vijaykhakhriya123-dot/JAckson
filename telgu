local typingUsers = {}

Remotes.BroadcastTyping.OnClientEvent:Connect(function(data)
    if not State.Settings.Typing or not data then return end

    if data.IsTyping then
        typingUsers[data.UserId] = data.DisplayName or "Player"
    else
        typingUsers[data.UserId] = nil
    end

    local names = {}
    for _, name in pairs(typingUsers) do
        table.insert(names, name)
    end

    if #names == 0 then
        TypingLabel.Visible = false
        TypingLabel.Text = ""
    else
        TypingLabel.Visible = true
        TypingLabel.Text = table.concat(names, ", ") .. (#names == 1 and " is typing..." or " are typing...")
    end
end)

