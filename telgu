--==================================================
-- SEND MESSAGE
--==================================================

local function SendMessage()

    local text = Input.Text

    if not text then
        return
    end

    text = text:gsub("^%s+", ""):gsub("%s+$", "")

    if text == "" then
        return
    end

    if #text > MAX_MESSAGE then
        text = string.sub(text, 1, MAX_MESSAGE)
    end

    if os.clock() - LastSend < COOLDOWN then
        Status.Text = "● WAIT"
        Status.TextColor3 = Color3.fromRGB(255, 190, 70)

        task.delay(1, function()
            Status.Text = "● LIVE"
            Status.TextColor3 = Color3.fromRGB(70, 220, 140)
        end)

        return
    end

    LastSend = os.clock()

    local payload = {
        username = Username,
        text = text,
        timestamp = os.time()
    }

    local encoded

    local success = pcall(function()
        encoded = game:GetService("HttpService"):JSONEncode(payload)
    end)

    if not success then
        return
    end

    local result = Http(
        "POST",
        FIREBASE_URL .. "/messages.json",
        encoded
    )

    if result then
        Input.Text = ""
    end
end

Send.MouseButton1Click:Connect(SendMessage)

Input.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        SendMessage()
    end
end)

--==================================================
-- FETCH MESSAGES
--==================================================

local function FetchMessages()

    local result = Http(
        "GET",
        FIREBASE_URL .. "/messages.json",
        ""
    )

    if not result then
        Status.Text = "● OFFLINE"
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    local body = result.Body

    if not body or body == "null" then
        Status.Text = "● LIVE"
        Status.TextColor3 = Color3.fromRGB(70, 220, 140)
        return
    end

    local data

    local ok = pcall(function()
        data = game:GetService("HttpService"):JSONDecode(body)
    end)

    if not ok or type(data) ~= "table" then
        return
    end

    local list = {}

    for id, message in pairs(data) do
        table.insert(list, {
            id = id,
            data = message
        })
    end

    table.sort(list, function(a, b)
        return (tonumber(a.data.timestamp) or 0)
            < (tonumber(b.data.timestamp) or 0)
    end)

    for _, item in ipairs(list) do
        AddMessage(item.id, item.data)
    end

    Status.Text = "● LIVE"
    Status.TextColor3 = Color3.fromRGB(70, 220, 140)
end

--==================================================
-- REPORT MESSAGE
--==================================================

local function ReportMessage(messageText)

    if not messageText or messageText == "" then
        return
    end

    local payload = {
        username = Username,
        message = string.sub(messageText, 1, MAX_MESSAGE),
        timestamp = os.time()
    }

    local encoded = game:GetService("HttpService"):JSONEncode(payload)

    Http(
        "POST",
        FIREBASE_URL .. "/reports.json",
        encoded
    )
end

