if RunService:IsServer() then
    local Players = game:GetService("Players")
    local TextService = game:GetService("TextService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local HttpService = game:GetService("HttpService")

    local CONFIG = {
        MaxMessageLength = 250,
        CooldownSeconds = 0.8,
        MaxMessagesInWindow = 5,
        RateLimitWindowSeconds = 5,
        BurstPenaltySeconds = 15,
        MaxReportsPerPlayer = 3,
        MaxGlobalMessageHistory = 100,
        MaxDMHistoryPerPair = 50,
        MaxSecurityLogs = 200,
        MaxNotesLength = 250,
        AdminUserIds = {
            -- [YOUR_USER_ID] = true,
        },
    }

    local network = ReplicatedStorage:FindFirstChild("NexusChatNetwork")
    if not network then
        network = Instance.new("Folder")
        network.Name = "NexusChatNetwork"
        network.Parent = ReplicatedStorage
    end

    local function remote(className, name)
        local old = network:FindFirstChild(name)
        if old and old.ClassName == className then
            return old
        end
        if old then old:Destroy() end
        local obj = Instance.new(className)
        obj.Name = name
        obj.Parent = network
        return obj
    end

    local Remotes = {
        SendMessage = remote("RemoteFunction", "SendMessage"),
        SendDM = remote("RemoteFunction", "SendDM"),
        DeleteMessage = remote("RemoteFunction", "DeleteMessage"),
        SubmitReport = remote("RemoteFunction", "SubmitReport"),
        AddReaction = remote("RemoteEvent", "AddReaction"),
        SendTyping = remote("RemoteEvent", "SendTyping"),
        BroadcastMessage = remote("RemoteEvent", "BroadcastMessage"),
        BroadcastDM = remote("RemoteEvent", "BroadcastDM"),
        BroadcastReaction = remote("RemoteEvent", "BroadcastReaction"),
        BroadcastTyping = remote("RemoteEvent", "BroadcastTyping"),
        SystemNotification = remote("RemoteEvent", "SystemNotification"),
    }

    local State = {
        Limits = {},
        Messages = {},
        DMSessions = {},
        Logs = {},
    }

    local function log(player, severity, reason)
        table.insert(State.Logs, 1, {
            Time = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            UserId = player and player.UserId or 0,
            Name = player and player.Name or "SYSTEM",
            Severity = severity,
            Reason = tostring(reason),
        })
        if #State.Logs > CONFIG.MaxSecurityLogs then
            table.remove(State.Logs)
        end
        if severity == "WARNING" or severity == "EXPLOIT_ATTEMPT" then
            warn("[NEXUS SECURITY] " .. tostring(reason))
        end
    end

    local function validPlayer(p)
        return typeof(p) == "Instance" and p:IsA("Player") and p:IsDescendantOf(Players)
    end

    local function validString(v, minLen, maxLen)
        return typeof(v) == "string" and #v >= minLen and #v <= maxLen
    end

    local function validNumber(v, minValue)
        return typeof(v) == "number" and v == v and v >= minValue
    end

    local function tracker(p)
        local id = p.UserId
        if not State.Limits[id] then
            State.Limits[id] = {
                LastMessage = 0,
                Requests = {},
                MutedUntil = 0,
                Reports = 0,
                ReportReset = os.time(),
                TypingAt = 0,
            }
        end
        return State.Limits[id]
    end

    local function rateLimit(p)
        local t = tracker(p)
        local now = os.clock()

        if now < t.MutedUntil then
            return false, ("Rate limit active. Wait %d second(s)."):format(math.ceil(t.MutedUntil - now))
        end

        if now - t.LastMessage < CONFIG.CooldownSeconds then
            log(p, "LOW", "Message cooldown violation")
            return false, "Sending messages too fast."
        end

        for i = #t.Requests, 1, -1 do
            if now - t.Requests[i] > CONFIG.RateLimitWindowSeconds then
                table.remove(t.Requests, i)
            end
        end

        table.insert(t.Requests, now)

        if #t.Requests > CONFIG.MaxMessagesInWindow then
            t.MutedUntil = now + CONFIG.BurstPenaltySeconds
            log(p, "WARNING", "Message burst rate limit exceeded")
            return false, ("Rate limit exceeded. Wait %d second(s)."):format(CONFIG.BurstPenaltySeconds)
        end

        t.LastMessage = now
        return true
    end

    local function filterText(text, sender, recipient)
        if not validString(text, 1, CONFIG.MaxMessageLength) then
            return nil, "Message must be 1-" .. CONFIG.MaxMessageLength .. " characters."
        end

        local ok, result = pcall(function()
            return TextService:FilterStringAsync(
                text,
                sender.UserId,
                Enum.TextFilterContext.PublicChat
            )
        end)

        if not ok or not result then
            log(sender, "WARNING", "TextService filtering failed")
            return nil, "Text processing failed."
        end

        local success, filtered = pcall(function()
            if recipient then
                return result:GetChatForUserAsync(recipient.UserId)
            end
            return result:GetNonChatStringForBroadcastAsync()
        end)

        if not success or not filtered then
            log(sender, "WARNING", "Filtered text retrieval failed")
            return nil, "Text moderation failed."
        end

        return filtered
    end

    local function isAdmin(p)
        return validPlayer(p)
            and (CONFIG.AdminUserIds[p.UserId] == true
            or (game.CreatorType == Enum.CreatorType.User and p.UserId == game.CreatorId))
    end

    local function sessionKey(a, b)
        a, b = tonumber(a), tonumber(b)
        if a > b then a, b = b, a end
        return ("%d_%d"):format(a, b)
    end

    local function registerMessage(data)
        State.Messages[data.Id] = data

        local ids = {}
        for id, msg in pairs(State.Messages) do
            table.insert(ids, {Id = id, Time = msg.Timestamp})
        end

        if #ids > CONFIG.MaxGlobalMessageHistory then
            table.sort(ids, function(a, b) return a.Time < b.Time end)
            for i = 1, #ids - CONFIG.MaxGlobalMessageHistory do
                State.Messages[ids[i].Id] = nil
            end
        end
    end

    Remotes.SendMessage.OnServerInvoke = function(player, text, replyId)
        if not validPlayer(player) then
            return false, "Invalid player."
        end

        local allowed, reason = rateLimit(player)
        if not allowed then return false, reason end

        local reply
        if replyId ~= nil and validString(replyId, 1, 100) then
            local original = State.Messages[replyId]
            if original and not original.IsDM then
                reply = {
                    Id = original.Id,
                    SenderId = original.SenderId,
                    SenderName = original.SenderDisplayName,
                    Text = original.Text,
                }
            end
        end

        local filtered, err = filterText(text, player, nil)
        if not filtered then return false, err end

        local id = "MSG_" .. HttpService:GenerateGUID(false)
        local payload = {
            Id = id,
            SenderId = player.UserId,
            SenderDisplayName = player.DisplayName,
            SenderUsername = player.Name,
            Text = filtered,
            Timestamp = os.time(),
            IsDM = false,
            ReplyTo = reply,
        }

        registerMessage(payload)
        Remotes.BroadcastMessage:FireAllClients(payload)
        return true, "Message sent."
    end

    Remotes.SendDM.OnServerInvoke = function(player, recipientId, text)
        if not validPlayer(player) then return false, "Invalid player." end
        if not validNumber(recipientId, 1) then return false, "Invalid recipient." end
        if recipientId == player.UserId then return false, "You cannot DM yourself." end

        local recipient = Players:GetPlayerByUserId(recipientId)
        if not recipient then return false, "Player is not in this server." end

        local allowed, reason = rateLimit(player)
        if not allowed then return false, reason end

        local filtered, err = filterText(text, player, recipient)
        if not filtered then return false, err end

        local key = sessionKey(player.UserId, recipient.UserId)
        State.DMSessions[key] = State.DMSessions[key] or {}

        local id = "DM_" .. HttpService:GenerateGUID(false)
        local payload = {
            Id = id,
            SenderId = player.UserId,
            SenderDisplayName = player.DisplayName,
            SenderUsername = player.Name,
            TargetId = recipient.UserId,
            Text = filtered,
            Timestamp = os.time(),
            IsDM = true,
        }

        registerMessage(payload)
        table.insert(State.DMSessions[key], payload)

        while #State.DMSessions[key] > CONFIG.MaxDMHistoryPerPair do
            table.remove(State.DMSessions[key], 1)
        end

        Remotes.BroadcastDM:FireClient(player, payload)
        Remotes.BroadcastDM:FireClient(recipient, payload)
        return true, "DM delivered."
    end

    Remotes.DeleteMessage.OnServerInvoke = function(player, id)
        if not validPlayer(player) or not validString(id, 1, 100) then
            return false, "Invalid request."
        end

        local msg = State.Messages[id]
        if not msg then return false, "Message not found." end

        if msg.SenderId ~= player.UserId and not isAdmin(player) then
            log(player, "EXPLOIT_ATTEMPT", "Unauthorized message deletion")
            return false, "Permission denied."
        end

        State.Messages[id] = nil
        Remotes.BroadcastMessage:FireAllClients({Action = "Delete", Id = id})
        return true, "Message deleted."
    end

    Remotes.AddReaction.OnServerEvent:Connect(function(player, id, emoji)
        if not validPlayer(player) then return end
        if not validString(id, 1, 100) or not validString(emoji, 1, 10) then return end

        local allowed = {
            ["❤️"] = true, ["👍"] = true, ["😂"] = true,
            ["😮"] = true, ["😢"] = true, ["🔥"] = true,
        }
        if not allowed[emoji] then
            log(player, "WARNING", "Unsupported reaction")
            return
        end

        local msg = State.Messages[id]
        if not msg then return end

        msg.Reactions = msg.Reactions or {}
        msg.Reactions[emoji] = (msg.Reactions[emoji] or 0) + 1

        Remotes.BroadcastReaction:FireAllClients({
            MessageId = id,
            Emoji = emoji,
            Count = msg.Reactions[emoji],
        })
    end)

    Remotes.SubmitReport.OnServerInvoke = function(player, data)
        if not validPlayer(player) or typeof(data) ~= "table" then
            return false, "Invalid report."
        end

        local t = tracker(player)
        local now = os.time()

        if now - t.ReportReset >= 600 then
            t.ReportReset = now
            t.Reports = 0
        end

        if t.Reports >= CONFIG.MaxReportsPerPlayer then
            return false, "Report limit reached. Please wait."
        end

        local target = data.TargetUserId
        local reason = data.Reason
        local notes = data.Notes or ""

        if not validNumber(target, 1)
            or not validString(reason, 1, 50)
            or not validString(notes, 0, CONFIG.MaxNotesLength) then
            log(player, "WARNING", "Malformed report payload")
            return false, "Invalid report data."
        end

        t.Reports += 1
        log(player, "WARNING",
            ("Report filed against %d | %s | %s"):format(target, reason, notes))

        return true, "Report submitted."
    end

    Remotes.SendTyping.OnServerEvent:Connect(function(player, isTyping)
        if not validPlayer(player) or typeof(isTyping) ~= "boolean" then return end

        local t = tracker(player)
        local now = os.clock()

        -- Allow the stop event immediately so indicators cannot get stuck.
        if isTyping and now - t.TypingAt < 1 then return end
        t.TypingAt = now

        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player then
                Remotes.BroadcastTyping:FireClient(other, {
                    UserId = player.UserId,
                    DisplayName = player.DisplayName,
                    IsTyping = isTyping,
                })
            end
        end
    end)

    Players.PlayerRemoving:Connect(function(player)
        State.Limits[player.UserId] = nil
        for key in pairs(State.DMSessions) do
            if key:find(tostring(player.UserId), 1, true) then
                State.DMSessions[key] = nil
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(900)
            local cutoff = os.time() - 7200
            for id, msg in pairs(State.Messages) do
                if msg.Timestamp < cutoff then
                    State.Messages[id] = nil
                end
            end
        end
    end)

    print("[Nexus Chat] Server security/message gateway ready.")
else

