--// Firebase REST Chat
-- Replace this URL only if you use a different Firebase Realtime Database.
local FIREBASE_URL = "https://zayn-c-default-rtdb.asia-southeast1.firebasedatabase.app"
local FIREBASE_CHAT_PATH = "/rubochat/messages"
local FIREBASE_POLL_INTERVAL = 2.5
local firebaseRequest = (syn and syn.request) or (http and http.request) or request

local function firebaseCall(method, path, body)
    if not firebaseRequest then
        return false, "HTTP request function is unavailable in this executor."
    end

    local ok, response = pcall(function()
        return firebaseRequest({
            Url = FIREBASE_URL .. path .. ".json",
            Method = method,
            Headers = {["Content-Type"] = "application/json"},
            Body = body and HttpService:JSONEncode(body) or nil
        })
    end)

    if not ok or not response then
        return false, "Request failed."
    end

    local code = tonumber(response.StatusCode or response.Status or 0) or 0
    if code < 200 or code >= 300 then
        return false, "HTTP " .. tostring(code)
    end

    local decoded
    if response.Body and response.Body ~= "" then
        pcall(function() decoded = HttpService:JSONDecode(response.Body) end)
    end
    return true, decoded
end

local function firebaseSendMessage(text)
    text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" or #text > 300 then return false, "Message must be 1-300 characters." end

    return firebaseCall("POST", FIREBASE_CHAT_PATH, {
        username = LocalPlayer.Name,
        displayName = LocalPlayer.DisplayName,
        userId = LocalPlayer.UserId,
        text = text,
        timestamp = os.time()
    })
end

local function firebaseReadMessages()
    return firebaseCall("GET", FIREBASE_CHAT_PATH)
end

