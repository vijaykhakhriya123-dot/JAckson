local function addMessage(payload, isDM)
    if not payload or State.Muted[payload.SenderId] then return end

    local isSelf = payload.SenderId == LocalPlayer.UserId

    local holder = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = MessageScroll,
    })

    local bubble = create("Frame", {
        Size = UDim2.new(0.88, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = isSelf and UDim2.new(1, 0, 0, 0) or UDim2.new(0, 0, 0, 0),
        AnchorPoint = isSelf and Vector2.new(1, 0) or Vector2.new(0, 0),
        BackgroundColor3 = isSelf and CONFIG.Colors.UserBubble or CONFIG.Colors.OtherBubble,
        Parent = holder,
    }, {
        corner(8),
        stroke(isSelf and CONFIG.Colors.UserBorder or CONFIG.Colors.OtherBorder, 1),
        create("UIPadding", {
            PaddingTop = UDim.new(0, 6),
            PaddingBottom = UDim.new(0, 6),
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8),
        }),
    })

    local meta = payload.SenderDisplayName or payload.SenderUsername or "Player"
    if State.Settings.Timestamps and payload.Timestamp then
        meta = meta .. " [" .. os.date("%H:%M", payload.Timestamp) .. "]"
    end
    if isDM then meta = "DM • " .. meta end

    create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 14),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = isSelf and CONFIG.Colors.Primary or CONFIG.Colors.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = meta,
        Parent = bubble,
    })

    local body = create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 16),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = CONFIG.Colors.Text,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = payload.Text or "",
        Parent = bubble,
    })

    if payload.ReplyTo then
        create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 14),
            Position = UDim2.new(0, 0, 0, 32),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamItalic,
            TextSize = 9,
            TextColor3 = CONFIG.Colors.Muted,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = "↳ " .. tostring(payload.ReplyTo.SenderName) .. ": " .. tostring(payload.ReplyTo.Text),
            Parent = bubble,
        })
    end

    local actions = create("Frame", {
        Size = UDim2.new(1, 0, 0, 22),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(0, 0, 1, 4),
        BackgroundTransparency = 1,
        Parent = bubble,
    }, {
        create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            Padding = UDim.new(0, 4),
        }),
    })

    local replyBtn = create("TextButton", {
        Size = UDim2.new(0, 48, 0, 20),
        BackgroundColor3 = CONFIG.Colors.Background,
        Text = "Reply",
        Font = Enum.Font.GothamMedium,
        TextSize = 9,
        TextColor3 = CONFIG.Colors.Muted,
        Parent = actions,
    }, {corner(4)})

    replyBtn.MouseButton1Click:Connect(function()
        setReply({
            Id = payload.Id,
            SenderName = payload.SenderDisplayName,
            Text = payload.Text,
        })
        MessageInput:CaptureFocus()
    end)

    for _, emoji in ipairs(CONFIG.Reactions) do
        local rb = create("TextButton", {
            Size = UDim2.new(0, 24, 0, 20),
            BackgroundColor3 = CONFIG.Colors.Background,
            Text = emoji,
            Font = Enum.Font.Gotham,
            TextSize = 10,
            Parent = actions,
        }, {corner(4)})
        rb.MouseButton1Click:Connect(function()
            Remotes.AddReaction:FireServer(payload.Id, emoji)
        end)
    end

    if isSelf then
        local del = create("TextButton", {
            Size = UDim2.new(0, 46, 0, 20),
            BackgroundColor3 = CONFIG.Colors.Background,
            Text = "Delete",
            Font = Enum.Font.GothamMedium,
            TextSize = 9,
            TextColor3 = CONFIG.Colors.Red,
            Parent = actions,
        }, {corner(4)})
        del.MouseButton1Click:Connect(function()
            local ok, msg = Remotes.DeleteMessage:InvokeServer(payload.Id)
            if not ok then notify(msg or "Delete failed.") end
        end)
    end

    table.insert(State.Messages, holder)
    State.MessageById[payload.Id] = holder

    while #State.Messages > CONFIG.MaxMessages do
        local old = table.remove(State.Messages, 1)
        if old then old:Destroy() end
    end

    task.defer(function()
        if State.Settings.AutoScroll then
            MessageScroll.CanvasPosition = Vector2.new(0, MessageScroll.AbsoluteCanvasSize.Y)
        end
    end)

    if not isSelf then
        State.Unread += 1
        UnreadBadge.Text = tostring(State.Unread)
        UnreadBadge.Visible = not State.Open
        playMessageSound()
    end
end

