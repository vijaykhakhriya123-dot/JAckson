local tabNames = {"Home", "Profile", "Friends", "Search", "Chat", "Scripts", "Settings", "About", "Leaderboard"}
local tabButtons = {}

local function showPage(name)
    for pageName, page in pairs(pages) do
        if pageName == name then
            page.Visible = true
            tween(page, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {ScrollBarImageTransparency = 0})
        else
            page.Visible = false
        end
    end

    for tabName, tab in pairs(tabButtons) do
        if tabName == name then
            tween(tab, TweenInfo.new(0.2), {BackgroundTransparency = 0.05, TextColor3 = THEME.White})
        else
            tween(tab, TweenInfo.new(0.2), {BackgroundTransparency = 0.55, TextColor3 = THEME.Muted})
        end
    end
end

for _, tabName in ipairs(tabNames) do
    local b = create("TextButton", {
        Size = UDim2.fromOffset(math.max(57, #tabName * 7 + 22), 26),
        BackgroundColor3 = THEME.Panel,
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
        Text = tabName,
        Font = Enum.Font.GothamSemibold,
        TextSize = 9,
        TextColor3 = THEME.Muted,
        AutoButtonColor = false
    }, tabBar)
    corner(b, 6)
    stroke(b, THEME.Blue, 0.78)
    tabButtons[tabName] = b

    b.MouseEnter:Connect(function() if not pages[tabName].Visible then tween(b, TweenInfo.new(0.2), {BackgroundTransparency = 0.3}) end end)
    b.MouseLeave:Connect(function() if not pages[tabName].Visible then tween(b, TweenInfo.new(0.2), {BackgroundTransparency = 0.55}) end end)
    b.Activated:Connect(function() showPage(tabName) end)
end

