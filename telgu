local function create(className, props, children)
    local x = Instance.new(className)
    for k, v in pairs(props or {}) do x[k] = v end
    for _, child in ipairs(children or {}) do child.Parent = x end
    return x
end

local function corner(radius)
    return create("UICorner", {CornerRadius = UDim.new(0, radius)})
end

local function stroke(color, thickness, transparency)
    return create("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function tween(obj, time, props, style, direction)
    if not State.Settings.Animations then
        for k, v in pairs(props) do obj[k] = v end
        return
    end
    local t = TweenService:Create(
        obj,
        TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function notify(text)
    if not State.Settings.Notifications then return end

    local toast = create("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = CONFIG.Colors.Panel,
        BackgroundTransparency = 0.08,
        Parent = ToastHolder,
    }, {
        corner(7),
        stroke(CONFIG.Colors.Primary, 1),
        create("TextLabel", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = CONFIG.Colors.Text,
            Text = text,
        }),
    })

    task.delay(2.5, function()
        if toast.Parent then
            local t = tween(toast, 0.2, {BackgroundTransparency = 1})
            if t then t.Completed:Wait() end
            toast:Destroy()
        end
    end)
end

