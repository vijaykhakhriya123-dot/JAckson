local URL = "https://zayn-c-default-rtdb.asia-southeast1.firebasedatabase.app"

local Request =
    (syn and syn.request)
    or (http and http.request)
    or http_request
    or request
    or (fluxus and fluxus.request)

if not Request then
    warn("RUBO FIREBASE: HTTP REQUEST FUNCTION NOT FOUND")
    return
end

local HttpService = game:GetService("HttpService")

local function Test()

    local ok, response = pcall(function()
        return Request({
            Url = URL .. "/messages.json",
            Method = "GET",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Accept"] = "application/json"
            }
        })
    end)

    if not ok then
        warn("RUBO FIREBASE ERROR:")
        warn(tostring(response))
        return
    end

    print("========== RUBO FIREBASE ==========")
    print("Status:", response.StatusCode)
    print("Body:", tostring(response.Body))
    print("===================================")

    if response.StatusCode == 200 then
        print("RUBO: FIREBASE CONNECTED ✓")
    elseif response.StatusCode == 401 then
        warn("RUBO: FIREBASE RULES BLOCKING REQUEST")
    elseif response.StatusCode == 404 then
        warn("RUBO: FIREBASE DATABASE URL INVALID")
    else
        warn("RUBO: FIREBASE HTTP ERROR " .. tostring(response.StatusCode))
    end
end

Test()
