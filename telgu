task.spawn(function()
    local ok, pagesObject = pcall(function()
        return Players:GetFriendsAsync(LocalPlayer.UserId)
    end)

    if not ok then
        friendStatus.Text = "Friends API unavailable in this environment."
        return
    end

    local count = 0

    repeat
        local current = pagesObject:GetCurrentPage()

        for _, friend in ipairs(current) do
            count += 1

            makeFriendRow({
                Id = friend.Id,
                Username = friend.Username,
                DisplayName = friend.DisplayName
            }, count)
        end

        if pagesObject.IsFinished then
            break
        end

        local nextOk = pcall(function()
            pagesObject:AdvanceToNextPageAsync()
        end)

        if not nextOk then
            break
        end
    until false

    friendStatus.Text = tostring(count) .. " friend(s) loaded"
end)

