local function label(parent, text, pos, size, textSize, color)
    return create("TextLabel", {
        Position = pos,
        Size = size,
        BackgroundTransparency = 1,
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = textSize or 12,
        TextColor3 = color or THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    }, parent)
end

local function button(parent, text, pos, size)
    local b = create("TextButton", {
        Position = pos,
        Size = size,
        BackgroundColor3 = THEME.Panel,
        BackgroundTransparency = 0.22,
        BorderSizePixel = 0,
        Text = text,
        Font = Enum.Font.GothamSemibold,
        TextSize = 11,
        TextColor3 = THEME.White,
        AutoButtonColor = false
    }, parent)
    corner(b, 7)
    stroke(b, THEME.Blue, 0.58)

    b.MouseEnter:Connect(function() tween(b, TweenInfo.new(0.15), {BackgroundTransparency = 0.02}) end)
    b.MouseLeave:Connect(function() tween(b, TweenInfo.new(0.15), {BackgroundTransparency = 0.22}) end)
    b.Activated:Connect(function()
        tween(b, TweenInfo.new(0.05), {Size = UDim2.new(size.X.Scale, size.X.Offset - 2, size.Y.Scale, size.Y.Offset - 2)})
        task.delay(0.05, function() if b.Parent then tween(b, TweenInfo.new(0.1), {Size = size}) end end)
    end)
    return b
end

local function panel(parent, pos, size)
    local p = create("Frame", {
        Position = pos,
        Size = size,
        BackgroundColor3 = THEME.Panel,
        BackgroundTransparency = 0.48,
        BorderSizePixel = 0
    }, parent)
    corner(p, 9)
    stroke(p, THEME.Blue, 0.72)
    return p
end

