                    Body = HttpService:JSONEncode({
                        sender = LocalPlayer.Name,
                        recipient = recipient,
                        text = encrypt(text, key),
                        timestamp = os.time()
                    })
                })
            end)
        else
            -- Global Send
            pcall(function()
                httprequest({
                    Url = FIREBASE_URL .. "messages.json",
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode({
                        sender = LocalPlayer.Name,
                        text = encrypt(rawText, GLOBAL_SECRET),
                        timestamp = os.time(),
                        customTitleExp = 0 -- Default 0, modify here to grant custom 24h title via code
                    })
                })
            end)
        end
    end
end)

--=========================================
-- LIVE POLLING (Fetching Users, Global & DMs Safely)
--=========================================
local lastTime = os.time()
task.spawn(function()
    while task.wait(2) do
        -- Safe Request Wrap Function
        local function fetchJSON(path)
            local s, res = pcall(function() return httprequest({Url = FIREBASE_URL .. path, Method = "GET"}) end)
            if s and res and res.Body and res.Body ~= "null" then return HttpService:JSONDecode(res.Body) end
            return nil
        end

        local usersData = fetchJSON("users.json")
        if usersData then
            GlobalUsersCache = {}
            for uname, _ in pairs(usersData) do table.insert(GlobalUsersCache, uname) end
        end
        
        local globalData = fetchJSON("messages.json")
        if globalData then
            for msgId, msg in pairs(globalData) do
                if msg.timestamp > lastTime then
                    lastTime = msg.timestamp
                    local decrypted = decrypt(msg.text, GLOBAL_SECRET)
                    renderMessage(msgId, msg.sender, decrypted, msg.customTitleExp, false)
                end
            end
        end
        
        local dmData = fetchJSON("dms.json")
        if dmData then
            for msgId, msg in pairs(dmData) do
                if msg.timestamp > lastTime and (msg.recipient == LocalPlayer.Name or msg.sender == LocalPlayer.Name) then
                    local key = getDMKey(msg.sender, msg.recipient)
                    local decrypted = decrypt(msg.text, key)
                    renderMessage(msgId, msg.sender, decrypted, 0, true)
                end
            end
        end
    end
end)
