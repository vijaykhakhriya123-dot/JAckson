    local function renderFavoritesLayoutView()
        for _, child in pairs(ResultsScroll:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
        end
        sessionQueue = {}
        
        local favs = getSavedFavorites()
        if #favs == 0 then
            StatusText.Text = "Notice: Favorites collection configuration registry is empty."
            local fallbackPlaque = Instance.new("TextLabel", ResultsScroll)
            fallbackPlaque.Size = UDim2.new(1, 0, 0, 50)
            fallbackPlaque.BackgroundTransparency = 1
            fallbackPlaque.Text = "⭐ No tracks saved yet! Add favorites inside player menu."
            fallbackPlaque.Font = Enum.Font.GothamMedium
            fallbackPlaque.TextSize = 11
            fallbackPlaque.TextColor3 = Color3.fromRGB(150, 130, 180)
            fallbackPlaque.ZIndex = 204
