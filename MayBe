--=========================================
-- RENDER MESSAGE (Fixed DP, Swipe Message, 24h Timeline)
--=========================================
local function renderMessage(msgId, sender, decryptedText, titleExp, isDM)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, 0, 0, 40)
    Container.BackgroundTransparency = 1
    
    -- Fixed DP Frame
    local DP = Instance.new("ImageLabel")
    DP.Size = UDim2.new(0, 30, 0, 30)
    DP.Position = UDim2.new(0, 0, 0, 5)
    DP.BackgroundTransparency = 1
    pcall(function() DP.Image = "rbxthumb://type=AvatarHeadShot&id=" .. Players:GetUserIdFromNameAsync(sender) .. "&w=150&h=150" end)
    Instance.new("UICorner", DP).CornerRadius = UDim.new(1, 0)
    DP.Parent = Container

    -- Message Swipe Frame
    local MsgFrame = Instance.new("Frame")
    MsgFrame.Size = UDim2.new(1, -40, 1, 0)
    MsgFrame.Position = UDim2.new(0, 40, 0, 0)
    MsgFrame.BackgroundTransparency = 1
    MsgFrame.Parent = Container
    
    local TextLabel = Instance.new("TextLabel")
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextXAlignment = Enum.TextXAlignment.Left
    TextLabel.TextColor3 = Themes[currentTheme].Text
    TextLabel.Font = Enum.Font.Gotham
    TextLabel.TextSize = 13
    TextLabel.TextWrapped = true

    local titlePrefix = ""
    if titleExp and titleExp > os.time() then titlePrefix = "[VIP] " end
    local dmTag = isDM and "[DM] " or ""
    TextLabel.Text = dmTag .. titlePrefix .. sender .. ": " .. decryptedText
    TextLabel.Parent = MsgFrame

    -- Swipe-to-Reply Logic (Only MsgFrame moves)
    local startX = 0
    MsgFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            startX = input.Position.X
        end
    end)
    MsgFrame.InputEnded:Connect(function(input)
        if startX > 0 and input.Position.X > startX + 40 then
            TweenService:Create(MsgFrame, TweenInfo.new(0.2), {Position = UDim2.new(0, 75, 0, 0)}):Play()
            task.wait(0.3)
            TweenService:Create(MsgFrame, TweenInfo.new(0.2), {Position = UDim2.new(0, 40, 0, 0)}):Play()
            ChatInput.Text = "@" .. sender .. " "
            ChatInput:CaptureFocus()
        end
        startX = 0
    end)

    -- Hold to React
    local holdStart = 0
    local isHolding = false
    MsgFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            isHolding = true
            holdStart = os.clock()
            task.delay(0.6, function()
                if isHolding and (os.clock() - holdStart) >= 0.5 then
                    print("React Menu Triggered for: " .. msgId)
                end
            end)
        end
    end)
    MsgFrame.InputEnded:Connect(function() isHolding = false end)

    Container.Parent = MessageList
    task.delay(0.1, smartScroll)
    showThemeBubble(sender, decryptedText)
end

