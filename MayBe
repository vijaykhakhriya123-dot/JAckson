    local function formatSeconds(val)
        if not val or val ~= val then return "00:00" end
        local m_val = math.floor(val / 60)
        local s_val = math.floor(val % 60)
        return string.format("%02d:%02d", m_val, s_val)
    end

    local function isSongTooLong(item)
        local d = item.duration or item.durationText or item.length or item.lengthText or item.videoDuration
        if type(d) == "number" then return d > 450 end
        if type(d) == "string" and d ~= "" then
            local p = string.split(d, ":")
            if #p == 2 and tonumber(p[1]) and tonumber(p[1]) > 7 then return true
            elseif #p >= 3 then return true end
        end
        return false
    end

